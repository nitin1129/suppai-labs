MONGO_URI=mongodb://localhost:27017
MONGO_DB=suppai_labs
# Needs a replica set (MongoDB Atlas has one). Set false for a plain local mongod.
USE_TRANSACTIONS=true

# Must be the same secret the main SuppAI app uses to sign member tokens. At least 32 characters.
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars

INVITE_LINK_BASE=https://suppai.in/lab/set-password
PUBLIC_BASE_URL=http://localhost:8000

# Where KYC files and report PDFs are stored. Use a persistent disk and back it up.
LOCAL_STORAGE_DIR=./storage
